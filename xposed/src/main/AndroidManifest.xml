<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="tv.danmaku.bili" />
    </queries>
    <application
        android:name=".ModuleApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_module"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".CatalogProvider"
            android:authorities="app.revanced.bilibili.xposed.catalog"
            android:exported="true" />
    </application>
</manifest>
